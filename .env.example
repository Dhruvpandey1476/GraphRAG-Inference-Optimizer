# ─── TigerGraph Savanna ───────────────────────────────────────────
TIGERGRAPH_HOST=your-cluster.i.tgcloud.io
TIGERGRAPH_GRAPH=GraphRAGDemo
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your-password-here
TIGERGRAPH_SECRET=your-secret-here

# Google Gemini API (deprecated — kept for reference)
GEMINI_API_KEY=your api key
GEMINI_MODEL=gemini-2.5-flash

# App Configuration
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=False

# Graph Settings
MAX_HOPS_GRAPH_RAG=2
MAX_NEIGHBORS=5
CONFIDENCE_THRESHOLD=0.7

# Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
EMBEDDING_MODEL=text-embedding-3-small

# Server Port
SERVER_PORT=8001
